[Unit]
Description=Omarchy Parallels first-boot setup
ConditionPathExists=/var/lib/omarchy-parallels/firstboot-pending
After=systemd-user-sessions.service getty@tty1.service
Before=sddm.service
Conflicts=getty@tty1.service

[Service]
Type=oneshot
StandardInput=tty
StandardOutput=tty
# Menus and prompts render on stderr so their return value can be captured on stdout. Without
# this line stderr would default to the journal and every prompt would be invisible on tty1.
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
ExecStart=/usr/local/bin/omarchy-parallels-firstboot
RemainAfterExit=no

[Install]
WantedBy=multi-user.target

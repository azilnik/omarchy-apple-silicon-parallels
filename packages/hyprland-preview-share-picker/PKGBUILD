# aarch64 build of hyprland-preview-share-picker. Upstream (WhySoBad) explicitly supports
# aarch64 — Omarchy simply didn't build it for the ARM tree. Pinned to the version Omarchy ships.
pkgname=hyprland-preview-share-picker
pkgver=0.2.1
pkgrel=1
pkgdesc="An alternative share picker for Hyprland with window and monitor previews"
arch=('aarch64')
url="https://github.com/WhySoBad/hyprland-preview-share-picker"
license=('MIT')
depends=('gtk4' 'gtk4-layer-shell' 'xdg-desktop-portal-hyprland' 'hyprland')
makedepends=('cargo' 'git')
optdepends=('slurp: default tool for selecting share regions')
source=("git+https://github.com/WhySoBad/hyprland-preview-share-picker.git#tag=v${pkgver}")
sha256sums=('SKIP')

prepare() {
  cd "$srcdir/$pkgname"
  git -c protocol.file.allow=always submodule update --init --recursive
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')" || cargo fetch
}

build() {
  cd "$srcdir/$pkgname"
  export CARGO_TARGET_DIR=target
  cargo build --release --locked || cargo build --release
  ./target/release/hyprland-preview-share-picker schema > schema.json 2>/dev/null || true
}

package() {
  cd "$srcdir/$pkgname"
  install -Dm0755 -T "target/release/hyprland-preview-share-picker" "$pkgdir/usr/bin/hyprland-preview-share-picker"
  [ -s schema.json ] && install -Dm0644 schema.json "$pkgdir/usr/share/hyprland-preview-share-picker/schema.json" || true
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE" 2>/dev/null || true
}

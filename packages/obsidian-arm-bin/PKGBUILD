# aarch64 Obsidian from the OFFICIAL upstream ARM64 desktop build. Obsidian is proprietary,
# so — like the x86_64 obsidian-bin AUR package — this downloads the vendor's own binary at
# build time and never redistributes it. Arch has no aarch64 Obsidian; upstream ships one.
pkgname=obsidian-arm-bin
pkgver=1.13.7
pkgrel=1
pkgdesc="A powerful knowledge base that works on local Markdown files (official ARM64 build)"
arch=('aarch64')
url="https://obsidian.md"
license=('custom')
depends=('gtk3' 'nss' 'libsecret' 'libxss' 'ripgrep')
provides=('obsidian')
conflicts=('obsidian')
options=('!strip')
source=("https://github.com/obsidianmd/obsidian-releases/releases/download/v${pkgver}/obsidian-${pkgver}-arm64.tar.gz")
sha256sums=('SKIP')

package() {
  cd "$srcdir/obsidian-${pkgver}-arm64"
  install -dm755 "$pkgdir/opt/obsidian"
  cp -a ./* "$pkgdir/opt/obsidian/"

  # Launcher wrapper. Under Parallels' virtio-gpu (software rendering) Electron's separate GPU
  # process crashes; --in-process-gpu folds it into the main process, and --no-sandbox is
  # required for Electron to start in this guest. Flags verified on this exact stack.
  install -dm755 "$pkgdir/usr/bin"
  cat > "$pkgdir/usr/bin/obsidian" <<'WRAP'
#!/bin/sh
export LIBGL_ALWAYS_SOFTWARE=1
exec /opt/obsidian/obsidian \
  --no-sandbox --ozone-platform=wayland \
  --disable-gpu --disable-gpu-compositing --in-process-gpu \
  "$@"
WRAP
  chmod 755 "$pkgdir/usr/bin/obsidian"

  [ -f obsidian.png ] && install -Dm644 obsidian.png \
    "$pkgdir/usr/share/icons/hicolor/256x256/apps/obsidian.png" || true

  install -dm755 "$pkgdir/usr/share/applications"
  cat > "$pkgdir/usr/share/applications/obsidian.desktop" <<'DESK'
[Desktop Entry]
Type=Application
Name=Obsidian
Comment=Knowledge base over local Markdown files
Exec=obsidian %u
Icon=obsidian
Terminal=false
Categories=Office;
MimeType=x-scheme-handler/obsidian;
DESK
}
